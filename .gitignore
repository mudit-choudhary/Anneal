# Virtual environments
/virtual_environments

# Papers, models, vector store, databases, logs and pids now live outside the
# repo, under ~/.local/share/anneal (or $ANNEAL_HOME) — see app/common/paths.py.
# These entries remain so a pre-move checkout, or a stray local run, cannot
# commit them.
/app/data
/app/vector_db
/app/runs
/app/models
/app/run
*.pt
*.onnx

# Python cache
__pycache__/
*.pyc

# Local databases
*.db

# Secrets / env setup
env_setup.sh
.env

# Local tool settings
/.claude
.pytest_cache

# Web UI: dependencies and build output (rebuild with: cd app/UI/frontend && npm install && npm run build)
/app/UI/frontend/node_modules
/app/UI/static

# Eval scratch: large or regenerable. Kept in git: scripts, manifests, question
# sets, parser timing stats, pre-registration, results and per-question rows.
.worktrees/
evals/corpus/*.pdf
evals/text/
evals/parsed/*/*.json
!evals/parsed/*/_stats.json
!evals/parsed/*/_stats_round1.json
evals/vector_db_eval/
evals/**/*.log
evals/**/*.tmp

# API credentials
evals/keys_export.sh
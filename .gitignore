# Virtual environments
/virtual_environments

# Data & generated artifacts
/data
/vector_db
/runs

# Model weights & caches (too large for git)
/models
*.pt
*.onnx

# Python cache
__pycache__/
*.pyc

# Local databases
*.db

# Secrets / env setup
env_setup.sh
.env

# Local tool settings
/.claude
.pytest_cache

# Service logs and PID files (scripts/ops.py)
/run

# Web UI: dependencies and build output (rebuild with: cd UI/frontend && npm install && npm run build)
/UI/frontend/node_modules
/UI/static

# Eval scratch: large or regenerable. Kept in git: scripts, manifests, question
# sets, parser timing stats, pre-registration, results and per-question rows.
.worktrees/
evals/corpus/*.pdf
evals/text/
evals/parsed/*/*.json
!evals/parsed/*/_stats.json
!evals/parsed/*/_stats_round1.json
evals/vector_db_eval/
evals/**/*.log
evals/**/*.tmp

# API credentials
evals/keys_export.sh
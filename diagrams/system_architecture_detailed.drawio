                <mxCell id="ln2" value="           QUERY PATH  FastAPI :4001 — trigger: a question from rag.py / the UI / rag_inspect.py" style="rounded=1;fillColor=#eef7ee;strokeColor=#82b366;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8" parent="1" vertex="1">

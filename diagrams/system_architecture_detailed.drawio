                <mxCell id="c0" value="collect_hyphenated_vocab()&#xa;all hyphenated compounds seen intact mid-line&#xa;(&quot;edge-centric&quot;, &quot;state-of-the-art&quot;) — evidence used&#xa;to tell a real hyphen from a line-wrap hyphen" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="60" y="510" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="per page: Page-header / Page-footer regions → dropped[] (metadata only)&#xa;swallowed Picture text → dropped.picture_text" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="60" y="655" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="order_regions()  reading order&#xa;— full-width (&gt; 0.6 × page width) and Authors regions&#xa;   are band separators&#xa;— inside a band: left column (center &lt; mid) top→bottom,&#xa;   then right column&#xa;— mostly-full-width page → single column, top→bottom" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="400" y="510" width="330" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="&#xa;LayoutAssembler.add_region()  per region, in order&#xa;text = join_lines(lines, vocab)   ← de-hyphenation&#xa;Title / Section-header / Authors → flush open paragraph, emit heading block&#xa;Caption / Footnote / Formula / Table → emit block; paragraph stays OPEN&#xa;Picture → nothing (anchor only)&#xa;List-item → append to open list, or open one&#xa;Text → if open paragraph doesn&#39;t end in .!? → merge_paragraph (continuation&#xa;   across column/page/caption) else open new paragraph" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="400" y="680" width="330" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="finish() → blocks [{type, page, text}]&#xa;types: title, section, authors, paragraph, list,&#xa;caption, table, formula, footnote" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="780" y="560" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c5" value="render_txt()  tags&#xa;# title · ## section · [AUTHORS] · [CAPTION] ·&#xa;[TABLE]…[/TABLE] · [FORMULA] · [FOOTNOTE]&#xa;blocks separated by blank lines" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="780" y="715" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="po" value="&#xa;data/processed/&lt;stem&gt;.txt   (human-readable)&#xa;data/processed/&lt;stem&gt;.json  (what the embedder reads)&#xa;{source, num_pages, dropped:{page_headers,&#xa; page_footers, picture_text}, blocks:[…]}" style="shape=cylinder3;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666;align=left;spacingLeft=14" parent="1" vertex="1">
                    <mxGeometry x="1170" y="530" width="330" height="110" as="geometry"/>

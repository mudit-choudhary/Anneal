    <diagram name="3 Download" id="p3">
        <mxGraphModel dx="1736" dy="859" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="download_manager — how a paper enters the system (status: none → downloaded)" style="text;align=left;fontSize=15;fontStyle=1;strokeColor=none;fillColor=none" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="main_loop()&#xa;trigger: `python downloader.py` (manual; not started by fresh_start.sh)&#xa;every CHECK_INTERVAL = 3600 s: ThreadPoolExecutor, one process_domain() per DOMAINS entry (10)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="620" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="process_domain(domain)&#xa;1 random start jitter 5–60 s (threads don&#39;t hit arXiv in lockstep)&#xa;2 registry probe — if :4000 is down, skip the whole cycle (never download what the pipeline can&#39;t see)&#xa;3 cutoff = get_smart_cutoff(): POST /get_last_checkpoint → newest published_at for the domain,&#xa;   else now − BACKFILL_DAYS (32)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="180" width="620" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="arxiv.Search  ti:&quot;domain&quot; OR abs:&quot;domain&quot;, newest first, unbounded" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450" parent="1" vertex="1">
                    <mxGeometry x="40" y="320" width="620" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="for each result:&#xa;  published &lt; cutoff  → break (caught up)&#xa;  downloads ≥ MAX_PAPERS_PER_DOMAIN (20) → break (per-cycle cap)&#xa;  stem = sanitize_filename(title)   ← [^a-zA-Z0-9_- ] removed, spaces→_, 100 chars; the key everywhere&#xa;  registry get_status(stem) truthy → continue (already known, any stage)&#xa;  download_pdf → data/raw_pdfs/&lt;stem&gt;.pdf   (skipped if the file already exists)&#xa;  register_download → POST /update_status {downloaded, domain, published_at}&#xa;  sleep 3–10 s; every 5–12 downloads a 30–90 s break" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="390" width="620" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="raw" value="&#xa;data/raw_pdfs/&lt;stem&gt;.pdf" style="shape=cylinder3;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666" parent="1" vertex="1">
                    <mxGeometry x="800" y="440" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="reg" value="registry :4000&#xa;status = downloaded&#xa;(+ domain, published_at → next cycle&#39;s checkpoint)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656" parent="1" vertex="1">
                    <mxGeometry x="880" y="560" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="next" value="WHAT FOLLOWS: parse_manager&#39;s parser_loop polls every 5 s for PDFs whose status == downloaded → page 4" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366" parent="1" vertex="1">
                    <mxGeometry x="40" y="600" width="620" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="alt" value="ALTERNATIVE ENTRY: scripts/register_pdfs.py&#xa;for PDFs copied into data/raw_pdfs/ by hand: get_status → if unknown, POST update_status downloaded.&#xa;Same end state, no arXiv. Used by fresh_start.sh after the registry DB is recreated." style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="770" y="80" width="480" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="cfg" value="config.py: DOMAINS, BACKFILL_DAYS, CHECK_INTERVAL, MAX_PAPERS_PER_DOMAIN, PDF_DIR, REGISTRY_URL" style="text;align=left;fontSize=11;fontStyle=2;strokeColor=none;fillColor=none" parent="1" vertex="1">
                    <mxGeometry x="40" y="660" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="x1" style="edgeStyle=orthogonalEdgeStyle;rounded=1" parent="1" source="a1" target="a2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="x2" style="edgeStyle=orthogonalEdgeStyle;rounded=1" parent="1" source="a2" target="a3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="x3" style="edgeStyle=orthogonalEdgeStyle;rounded=1" parent="1" source="a3" target="a4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="x4" style="edgeStyle=orthogonalEdgeStyle;rounded=1" parent="1" source="a4" target="raw" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="x5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#d6b656" parent="1" source="a4" target="reg" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="x6" style="edgeStyle=orthogonalEdgeStyle;rounded=1" parent="1" source="a4" target="next" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="x7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1" parent="1" source="alt" target="reg" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>

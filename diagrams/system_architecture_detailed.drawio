                <mxCell id="st2" value="              STAGE 2  txt_processor.py   trigger: processor_loop (main.py) every 5 s finds parsed/*.json with registry status == parsed" style="rounded=1;fillColor=#eef7ee;strokeColor=#82b366;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8" parent="1" vertex="1">

    <diagram name="4 Parse" id="p4">
        <mxGraphModel dx="1736" dy="859" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="parse_manager — two stages, two statuses. Stage 1 answers &quot;what is on the page&quot;; stage 2 answers &quot;in what order, and what belongs together&quot;." style="text;align=left;fontSize=15;fontStyle=1;strokeColor=none;fillColor=none" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1050" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="st1" value="           STAGE 1  pdf_parser.py   trigger: parser_loop (main.py) every 5 s finds raw_pdfs/*.pdf with registry status == downloaded" style="rounded=1;fillColor=#eef3fb;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="70" width="1560" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="LayoutDetector.detect_pdf()&#xa;layout_detector.py&#xa;— MODEL_CANDIDATES: first existing wins&#xa;   (yolo11s fine-tuned → yolo11n → pretrained)&#xa;— render page → RGB @ RENDER_DPI 150 (PyMuPDF)&#xa;— YOLO_BATCH 4 pages, imgsz 1024, conf 0.30&#xa;— CUDA OOM → fall back to CPU, keep going&#xa;— boxes × 72/150 → PDF points" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="60" y="140" width="300" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="b1o" value="per page: regions [{label, conf, bbox}]&#xa;12 labels: Text, Title, Section-header, Authors,&#xa;List-item, Caption, Table, Formula, Footnote,&#xa;Picture, Page-header, Page-footer" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="60" y="330" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="page.get_text(&quot;words&quot;)  (PyMuPDF)&#xa;every word with its bbox, block, line" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="420" y="140" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="assign_words_to_regions()&#xa;word center → SMALLEST region containing it&#xa;   (a Caption on top of a Picture keeps its words)&#xa;label ∈ SWALLOW_LABELS (Picture, Page-header,&#xa;   Page-footer) → word recorded in swallowed_text,&#xa;   excluded from the flow  ← figure text / running heads&#xa;no region → grouped by PyMuPDF block into a&#xa;   fallback Text region (conf 0) — nothing is lost" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="400" y="265" width="320" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="words_to_lines()&#xa;cluster by y-center (tol 0.6 × median word height),&#xa;sort left→right → region.lines[]" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="760" y="185" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="b5" value="drop empty non-visual regions&#xa;(Picture/Table/Formula anchors kept)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="760" y="330" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="pj" value="&#xa;data/parsed/&lt;stem&gt;.json&#xa;{source_pdf, num_pages, pages:[{page, width, height,&#xa;  regions:[{label, conf, bbox, lines[], fallback?}],&#xa;  swallowed_text:[{text, label, bbox}]}]}" style="shape=cylinder3;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666;align=left;spacingLeft=14" parent="1" vertex="1">

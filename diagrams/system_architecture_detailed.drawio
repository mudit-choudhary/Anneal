    <diagram name="6 Query" id="p6">
        <mxGraphModel dx="1736" dy="859" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="Query path — from a typed question to a cited, streamed answer (UI and CLI share rag_setup/rag.py)" style="text;align=left;fontSize=15;fontStyle=1;strokeColor=none;fillColor=none" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="u0" value="User" style="shape=actor;fillColor=#ffffff;strokeColor=#666" parent="1" vertex="1">
                    <mxGeometry x="50" y="125" width="50" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="u1" value="UI/index.html  (single page, no build)&#xa;— question box · paper filter (checkboxes from /api/papers)&#xa;— backend select local | gemini · status dots (poll /api/status 10 s)&#xa;— fetch POST /api/query, read ndjson stream line by line&#xa;— render markdown; [n] → citation chips linked to the sources panel" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="150" y="100" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="u2" value="UI/main.py  FastAPI :4002&#xa;POST /api/query {query, filenames?, backend?}&#xa;→ rag.fetch_chunks → slice N_RESULTS (6) → rag.build_context&#xa;→ yield {type: sources, sources[{n, filename, title, section, page_start, page_end, text, distance}]}&#xa;→ local: for delta in rag.stream_local → {type: delta, text}&#xa;   gemini: one {type: delta} with the whole answer&#xa;→ {type: done}   (or {type: error, message} at any point — never a hang)&#xa;GET /api/status → ollama /api/tags (daemon up? model pulled?) + :4001/healthcheck&#xa;GET /api/papers → :4001/list_files" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="80" y="300" width="520" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="cli" value="rag_setup/rag.py  __main__&#xa;input() question + optional filename filter → main() → prints answer" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="150" y="540" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r1" value="rag.fetch_chunks(query, filenames, n_results=N_RESULTS)&#xa;GET http://127.0.0.1:4001/get_chunks" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="750" y="100" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r2" value="rag.build_context(documents, metadatas)&#xa;&quot;[1] (from: {title}, p.{page})\n{chunk text}&quot; … joined by blank lines&#xa;source_label(): title (else prettified filename) + 1-indexed page(s)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="750" y="180" width="420" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="r3" value="_local_payload()&#xa;system: SYSTEM_PROMPT — only the excerpts, cite [n] after each claim,&#xa;        say so if the excerpts don&#39;t contain the answer, be concise&#xa;user: &quot;Excerpts:\n\n{context}\n\nQuestion: {query}&quot;&#xa;model qwen3:4b-instruct · think false · keep_alive 30m&#xa;options num_ctx 6144 · temperature 0.2" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="750" y="280" width="420" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="r4" value="stream_local()  POST /api/chat stream=true&#xa;buffers the head to detect and drop a leaked &lt;think&gt;…&lt;/think&gt;&#xa;yields answer text as it arrives · answer_local() = same, non-streamed + strip_thinking()" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="750" y="430" width="420" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="r5" value="answer_gemini()  google-genai generate_content(gemini-2.5-flash)&#xa;requires GEMINI_API_KEY (env) — off otherwise" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="750" y="530" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="em" value="embedding_manager :4001&#xa;(page 5, query path)" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf" parent="1" vertex="1">
                    <mxGeometry x="1220" y="100" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ol" value="Ollama daemon 127.0.0.1:11434  (systemd, auto-start)&#xa;loads qwen3:4b-instruct on first request (~10–20 s),&#xa;decides CPU/GPU split at load, unloads after keep_alive idle&#xa;model blobs: /usr/share/ollama/.ollama/models" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="1230" y="420" width="340" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="cfg" value="rag_setup/config.py: LLM_BACKEND (env, default local) · OLLAMA_URL · OLLAMA_MODEL (env) · OLLAMA_NUM_CTX · OLLAMA_KEEP_ALIVE · GEMINI_API_KEY (env) · GEMINI_MODEL · EMBEDDING_URL · N_RESULTS" style="text;align=left;fontSize=11;fontStyle=2;strokeColor=none;fillColor=none;whiteSpace=wrap" parent="1" vertex="1">
                    <mxGeometry x="150" y="620" width="1000" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="v0" style="edgeStyle=orthogonalEdgeStyle;rounded=1" parent="1" source="u0" target="u1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="u1" target="u2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>

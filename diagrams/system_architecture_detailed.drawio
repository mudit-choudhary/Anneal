                <mxCell id="v9" value="ndjson stream back to the page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#82b366;entryX=0.75;entryY=1;entryDx=0;entryDy=0;exitX=0.683;exitY=0.021;exitDx=0;exitDy=0;exitPerimeter=0;" parent="1" source="u2" target="u1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>

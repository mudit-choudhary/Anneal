                    </mxGeometry>
                </mxCell>
                <mxCell id="v2b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" parent="1" source="cli" target="r1" edge="1">
                    <mxGeometry relative="1" as="geometry">

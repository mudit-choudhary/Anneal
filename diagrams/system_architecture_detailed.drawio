    </diagram>
    <diagram name="7 Prune" id="p7">
        <mxGraphModel dx="1736" dy="859" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="prune_manager — keeps disk bounded without ever removing the input you&#39;d need to rebuild" style="text;align=left;fontSize=15;fontStyle=1;strokeColor=none;fillColor=none" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="deletion_loop()  trigger: timer, every PRUNE_INTERVAL = 1800 s (started by fresh_start.sh / start_query.sh --with-ingest)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="700" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="RULES  (directory → delete a file once its paper&#39;s status is in …)&#xa;data/parsed/      → {processed, embedded}     stage-1 output is consumed by stage 2&#xa;data/processed/   → {embedded}                consumed by the embedder&#xa;data/raw_pdfs/    → {parsed, processed, embedded}  ONLY if PRUNE_RAW_PDFS = True (default False)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="40" y="160" width="700" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="sweep(directory, delete_when)&#xa;for each file: stem = name without extension → GET /get_status(stem)&#xa;  status ∈ delete_when → os.remove&#xa;  status None (unknown to registry) → left alone&#xa;  registry unreachable → abort this sweep, try again next interval" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="40" y="300" width="700" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="reg" value="registry :4000  get_status" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656" parent="1" vertex="1">
                    <mxGeometry x="810" y="460" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="&#xa;data/parsed/" style="shape=cylinder3;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666" parent="1" vertex="1">
                    <mxGeometry x="820" y="160" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="&#xa;data/processed/" style="shape=cylinder3;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666" parent="1" vertex="1">
                    <mxGeometry x="960" y="160" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="d3" value="&#xa;data/raw_pdfs/&#xa;(kept)" style="shape=cylinder3;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366" parent="1" vertex="1">
                    <mxGeometry x="1100" y="160" width="90" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="why" value="WHY keep raw PDFs: every parser / chunker / embedding-model change rebuilds from them (fresh_start.sh), and the planned VLM pass over tables and figures needs their page images. Titles in the registry can&#39;t recover the content." style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;dashed=1;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="440" width="700" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="w1" style="edgeStyle=orthogonalEdgeStyle;rounded=1" parent="1" source="p1" target="p2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w2" style="edgeStyle=orthogonalEdgeStyle;rounded=1" parent="1" source="p2" target="p3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#d6b656;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" parent="1" source="p3" target="reg" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w4" value="delete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" parent="1" source="p3" target="d1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w5" value="delete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450" parent="1" source="p3" target="d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="8 Operations" id="p8">
        <mxGraphModel dx="1736" dy="859" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="Operations — the scripts that start, stop, reset and inspect the pipeline (scripts/)" style="text;align=left;fontSize=15;fontStyle=1;strokeColor=none;fillColor=none" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="lib" value="service_lib.sh  (sourced by the two start scripts)&#xa;ROOT, PY (globalragsetup_env), run/logs, run/pids&#xa;start name dir script [ENV=…]: nohup env PYTHONUNBUFFERED=1 … &amp;  → pid file (no subshell → the pid IS the service)&#xa;require_port_free · wait_for_http · check_ollama · unload_ollama_models (so Qwen reloads onto a free GPU)" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="40" y="70" width="760" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="fs" value="fresh_start.sh [--yes] [--limit N] [--no-ui]   — REBUILD EVERYTHING&#xa;1 stop_services.sh · unload Ollama models&#xa;2 reset_ingestion.py (dry run shown, then --yes): delete data/parsed/*, data/processed/*, vector_db/, registry DB file&#xa;3 start registry → wait for :4000/openapi.json → must still be alive&#xa;4 register_pdfs.py [--limit N] → every raw PDF becomes status downloaded&#xa;5 start parse, embedding (EMBED_DEVICE=cuda), prune, [ui]&#xa;→ the loops take it from here; watch with pipeline_status.py; block with wait_for_ingestion.py" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="40" y="200" width="760" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="sq" value="start_query.sh [--with-ingest]   — DAILY START, nothing purged&#xa;stop_services.sh · unload Ollama models · start registry → embedding (EMBED_DEVICE=cpu; cuda with --with-ingest,&#xa;plus parse + prune) → ui · wait for :4001/list_files (model load) and :4002/api/status · print paper count" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="40" y="380" width="760" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ss" value="stop_services.sh&#xa;for each run/pids/*.pid: kill the process tree (TERM, then KILL) · sweep 1: pgrep any venv python running main.py|pruning.py|downloader.py&#xa;· sweep 2: anything from this repo listening on 4000/4001/4002 — so a stale process can never shadow a fresh one" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">

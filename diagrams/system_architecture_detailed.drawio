    <diagram name="5 Embedding" id="p5">
        <mxGraphModel dx="1736" dy="859" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="embedding_manager — turns typed blocks into retrievable chunks, and serves retrieval" style="text;align=left;fontSize=15;fontStyle=1;strokeColor=none;fillColor=none" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="640" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ln1" value="            INGEST PATH  main.py chunks_and_embed_loop — trigger: every 60 s, processed/*.json whose registry status == processed" style="rounded=1;fillColor=#eef3fb;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="40" y="70" width="1560" height="460" as="geometry"/>
                </mxCell>
                <mxCell id="pj" value="&#xa;data/processed/&lt;stem&gt;.json  blocks[]" style="shape=cylinder3;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666" parent="1" vertex="1">
                    <mxGeometry x="50" y="190" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="ck" value="chunking.py  chunk_document()   (pure: no config/DB imports)title := first title block (else filename); section := latest section block&#xa;&#xa;section / title  → flush packer, remember heading (never a chunk of its own)&#xa;authors, footnote → skipped[] (never embedded)&#xa;caption + adjacent table → ONE standalone chunk (split by lines if &gt; max)&#xa;formula → inline unit if ≥ 10 chars &amp; has letters, else dropped (&quot;(3)&quot;)&#xa;list → one unit per item&#xa;paragraph → one unit; if &gt; CHUNK_MAX_CHARS 2000 → split_long_text():&#xa;   sentence boundaries (abbreviations protected), 1-sentence overlap&#xa;&#xa;_Packer: units accumulate until CHUNK_TARGET_CHARS 1500 would be exceeded → emit&#xa;emit(): text = &quot;{title} › {section}\n\n{body}&quot;   ← heading path is IN the embedded text&#xa;        metadata = {filename, title, section, page_start, page_end, block_types, chunk_index, n_chars}" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="320" y="110" width="540" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="emb" value="embeddings.py  chunk_and_embed()&#xa;collection = papers_bge_base_v1 (cosine, HNSW)&#xa;collection.delete(where filename)  ← re-embedding a paper replaces its chunks&#xa;collection.add(documents, metadatas, ids=&quot;{stem}_{chunk_index}&quot;)&#xa;   documents → BGEEmbeddingFunction (bge-base-en-v1.5, normalized) on EMBED_DEVICE&#xa;   metadatas → stored beside the vector, never embedded, filterable &amp; updatable" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="980" y="110" width="600" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="hf" value="&#xa;&#xa;~/.cache/huggingface/hub/&#xa;models--BAAI--bge-base-en-v1.5&#xa;(downloaded on first start, ~440 MB)&#xa;512-token window ≈ 2600 chars" style="shape=cylinder3;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6" parent="1" vertex="1">
                    <mxGeometry x="980" y="280" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="vdb" value="&#xa;vector_db/  (ChromaDB PersistentClient)&#xa;collection papers_bge_base_v1&#xa;per chunk: id, document (text), 768-d vector, metadata" style="shape=cylinder3;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366" parent="1" vertex="1">
                    <mxGeometry x="1280" y="290" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="reg" value="POST /update_status embedded  (only on success; failures are logged and retried next poll)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656" parent="1" vertex="1">

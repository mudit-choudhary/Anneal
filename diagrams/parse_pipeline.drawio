<mxfile host="app.diagrams.net">
  <diagram name="Parse Pipeline" id="parse-pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="stage1" value="Stage 1 — pdf_parser.py (PDF → layout JSON)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1080" height="240" as="geometry" />
        </mxCell>
        <mxCell id="pdf" value="PDF&#10;data/raw_pdfs/" style="shape=cylinder3;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="render" value="Render pages&#10;PyMuPDF @ 150 DPI" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="220" y="90" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="words" value="Extract words&#10;page.get_text('words')" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="220" y="180" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="yolo" value="YOLOv11n layout model&#10;imgsz=1024, conf=0.30, batch=4&#10;CUDA → CPU fallback on OOM" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="410" y="80" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="map" value="Map boxes to PDF points&#10;scale = 72 / DPI" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="650" y="90" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="assign" value="Assign words → regions&#10;smallest containing box wins&#10;Picture/header/footer text swallowed&#10;uncovered words → fallback Text" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="650" y="170" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ljson" value="Layout JSON&#10;data/parsed/*.json" style="shape=cylinder3;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="920" y="150" width="130" height="90" as="geometry" />
        </mxCell>

        <mxCell id="stage2" value="Stage 2 — txt_processor.py (layout JSON → tagged text)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1080" height="220" as="geometry" />
        </mxCell>
        <mxCell id="order" value="Reading order&#10;full-width + Authors = band separators&#10;left column before right column" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="90" y="400" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="assemble" value="Paragraph assembly&#10;merge across columns/pages unless&#10;terminal punctuation; de-hyphenation;&#10;survives captions/footnotes in between" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="370" y="395" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tags" value="Tagged blocks&#10;# Title, ## Section, [AUTHORS]&#10;[CAPTION] [TABLE] [FORMULA] [FOOTNOTE]&#10;headers/footers + picture text dropped" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="680" y="395" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="out" value="Processed output&#10;data/processed/*.txt + *.json" style="shape=cylinder3;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="970" y="395" width="130" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1" edge="1" parent="1" source="pdf" target="render"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1" edge="1" parent="1" source="pdf" target="words"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1" edge="1" parent="1" source="render" target="yolo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1" edge="1" parent="1" source="yolo" target="map"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1" edge="1" parent="1" source="map" target="assign"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1" edge="1" parent="1" source="words" target="assign"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1" edge="1" parent="1" source="assign" target="ljson"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1" edge="1" parent="1" source="ljson" target="order"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1" edge="1" parent="1" source="order" target="assemble"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1" edge="1" parent="1" source="assemble" target="tags"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1" edge="1" parent="1" source="tags" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
